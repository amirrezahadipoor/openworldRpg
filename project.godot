; Engine configuration file.
; OpenWorld RPG — see DECISIONS.md #2 for the resolution/scaling strategy.

config_version=5

[application]

config/name="OpenWorld RPG"
config/description="A complete 2D open-world action RPG for Android."
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.4", "GL Compatibility")
boot_splash/bg_color=Color(0.07, 0.09, 0.12, 1)
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
ItemsDB="*res://scripts/autoload/items_db.gd"
EnemyDB="*res://scripts/autoload/enemy_db.gd"
GameState="*res://scripts/autoload/game_state.gd"
QuestManager="*res://scripts/autoload/quest_manager.gd"
DialogueDB="*res://scripts/autoload/dialogue_db.gd"
PoolManager="*res://scripts/autoload/pool_manager.gd"
SaveSystem="*res://scripts/autoload/save_system.gd"
AudioManager="*res://scripts/autoload/audio_manager.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/handheld/orientation=0
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

