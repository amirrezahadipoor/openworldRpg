# --- Godot 4 ---
.godot/
*.tmp
*.translation
export_credentials.cfg

# --- Build output (produced by CI/local exports, never committed) ---
build/
*.apk
*.aab
*.keystore
*.jks

# --- Toolchain & heavy binaries must NEVER enter the repo ---
rpg-toolchain/
*.tpz
*.AppImage

# --- OS / editor junk ---
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# --- Gradle android build template (CI installs it in-project; never commit) ---
android/

# Python bytecode from the authoring tools
tools/**/__pycache__/
__pycache__/

# --- Generated pose sources (dev-time inputs; parked in /tmp between batches,
#     see tools/pose_sources.sh and DECISIONS #78) ---
assets/lpc/_attack_src/*.png
assets/lpc/_idle_src/*.png
assets/lpc/_cast_src/*.png
